{
  "name": "@minicity/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:restore": "node dist/restoreBackup.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:integration": "npm run build && node tests/integration.mjs && node tests/restore.mjs",
    "test:admin-ui": "npm run build && node tests/admin-ui.mjs",
    "gen:npc-catalog": "node scripts/generateNpcCatalog.mjs"
  },
  "dependencies": {
    "ali-oss": "^6.23.0",
    "better-sqlite3": "^11.10.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.21",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
