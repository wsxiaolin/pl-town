# Copy to /etc/minicity/minicity.env as mode 0640, owned by root:minicity.
NODE_ENV=production
HOST=127.0.0.1
PORT=8787
DATA_DIR=/var/lib/minicity
LOG_DIR=/var/log/minicity
BACKUP_DIR=/var/backups/minicity

# Exact browser origins, comma-separated, with no path or trailing slash.
ALLOWED_ORIGINS=https://city.example.com
# Nginx is the only trusted reverse proxy in the supplied deployment.
TRUST_PROXY_HOPS=1
ALLOW_ORIGINLESS_WEBSOCKET=false

# Both values are intentionally empty so a copied file fails closed until real
# credentials are supplied. The password must contain at least 16 characters.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Optional additional accounts as a JSON object. Keep the whole value quoted.
# ADMIN_ACCOUNTS_JSON='{"operator2":"another-random-password-at-least-16-characters"}'
ADMIN_SESSION_TTL_MINUTES=480

SESSION_TTL_DAYS=30
MAX_CONNECTIONS=500
MAX_CONNECTIONS_PER_IP=20

AUTO_BACKUP_ENABLED=true
BACKUP_ON_START=true
BACKUP_INTERVAL_MINUTES=1440
BACKUP_RETENTION_DAYS=30
BACKUP_MAX_FILES=30

# Automatic chat text moderation via the ZhipuAI (BigModel) content safety API.
# Leave ZHIPUAI_API_KEY empty to disable background moderation. The key is only
# ever read from the environment and is never logged or exposed to clients.
ZHIPUAI_API_KEY=
# MODERATION_API_URL=https://open.bigmodel.cn/api/paas/v4/moderations
# MODERATION_TIMEOUT_MS=10000
LOG_LEVEL=info
